{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(label|menu|if|elif|else|while|for|def|screen|transform|image|button|choice|parallel|on|init|python|\\s*\".*\")\\b[^#]*:\\s*(#.*)?$|:\\s*$",
    "decreaseIndentPattern": "^\\s*(elif|else|return|break|continue)\\b.*$"
  }
}
