# vnengine demo script
# A short visual novel demonstrating dialogue, choices, branches,
# variables, audio, transitions, rich text, loops, transforms,
# and multiple characters.

define e = Character("Eileen", color = "#ff4040")
define r = Character("Ren", color = "#4080ff")
define n = Character("Narrator", color = "#cccccc")
# NVL narrator: `kind="nvl"` renders lines full-window.
define nv = Character(None, kind="nvl")

# Default variables (only set if not already restored from a save)
default eileen_affection = 0
default met_eileen = False

achievement true_end "Reach the true ending"
achievement all_endings "See every possible ending"

# User-defined function: display a formatted thought
def thought:
    n "{i}A quiet thought crosses my mind...{/i}"
    return

# Expression functions (callable in $ assignments, return a value)
def double_it(x):
    return x * 2

def pick_one(options):
    return choice(options)

def describe_hero(h):
    $ desc = h.name + " is level " + str(h.level)
    return desc

# ATL transform blocks (Phase 2): the VM compiles them into tracks
# that tick on the scene clock. `show ... at bob` attaches them.
transform bob:
    ease 0.8 yoffset -0.015
    ease 0.8 yoffset 0.0
    repeat

# Event tracks: `on show`/`on hide` fire on attach/hide.
transform fadein:
    on show:
        alpha 0.0
        ease 0.4 alpha 1.0
    on hide:
        ease 0.4 alpha 0.0

# Composite image: several asset layers drawn as one sprite.
image duo:
    "eileen happy" offset=(-0.18, 0.0) zoom=0.9
    "ren smile" offset=(0.18, 0.0) zoom=0.9 alpha=0.95

# Declarative screens (Phase 3): resolved UI nodes shown over the game.
screen hud:
    box x=0.0 y=0.0 w=1.0 h=0.06 color="#000000"
    text "Affection: [eileen_affection]" x=0.02 y=0.015 size=18 color="#ffcc00"
    button "Wave" x=0.88 y=0.008 w=0.1 h=0.045:
        set waved = True

screen greet:
    box x=0.3 y=0.3 w=0.4 h=0.4 color="#101030"
    text "How do you greet her?" x=0.35 y=0.36 size=26 color="#ffffff"
    button "Wave hello" x=0.35 y=0.46 w=0.3 h=0.06:
        return "wave"
    button "Bow politely" x=0.35 y=0.56 w=0.3 h=0.06:
        return "bow"

label start:
    scene bg school with dissolve 1.5
    play music "bgm_school.ogg" fade 2.0
    plugin journal "chapter", "gate"
    n "The sun was setting over Sakura High, painting everything in gold."
    n "A gentle breeze carried the scent of {b}cherry blossoms{/b} through the air."
    play sfx "sfx_wind.ogg" volume 0.6
    n "I was running late, as usual."
    n "Eileen had texted me to meet her after class, but the teacher kept us behind."
    pause 1.0
    n "When I finally reached the school gate, she was already there."

    show eileen happy at center, bob with dissolve
    e "Hey! You're finally here."
    e "I've been waiting for you, you know."
    play sfx "sfx_footstep.ogg" volume 0.8
    n "She bounced on her heels, her smile bright despite the wait."
    $ met_eileen = True

    # Declarative screens: an ambient HUD plus a blocking call screen.
    $ waved = False
    show screen hud
    call screen greet set greeting
    if greeting == "bow":
        $ eileen_affection += 1
        e "Oh, so formal! I like that."
    else:
        e "Hey! Right back at you."

    # Demonstrate rich text and compound assignment
    $ score = 0
    e "Let me test something... {color=#ff4040}red text{/color} and {b}bold{/b}!"
    $ score += 5
    e "Score is now [score]. That was a compound assignment!"
    $ score *= 2
    e "Now it's [score]. Multiplication works too!"

    menu:
        "Sorry I'm late! The teacher kept us.":
            $ apology = True
            show eileen surprised at center
            e "The teacher? Again?"
            e "You should learn to sneak out like I do."
            show eileen happy at center
            e "It's okay though. I'm just glad you came."
            jump talk
        "I got held up. It wasn't my fault.":
            $ apology = False
            show eileen thinking at center
            e "Hmm... you always have an excuse, don't you?"
            e "Well, I'll let it slide this time."
            show eileen happy at center
            e "Just don't make a habit of it!"
            jump talk

label talk:
    e "So, what do you want to do today?"
    n "She looked at me expectantly, her eyes sparkling in the evening light."

    # Demonstrate a while loop with countdown
    $ countdown = 3
    while countdown > 0:
        n "Countdown: [countdown]..."
        $ countdown -= 1
    n "Time's up!"

    # Demonstrate for loop over a list
    $ colors = ["red", "blue", "green"]
    n "Let me list some colors:"
    for color in colors:
        n "Color: [color]"
    n "That's all the colors!"

    # Dictionaries, slicing, membership, builtins and expression functions
    $ hero = {"name": "You", "level": 1, "gold": 120}
    n "[hero.name] — level [hero.level], [hero.gold] gold."
    n "Stats check: [describe_hero(hero)]"
    $ bag = ["potion", "key", "gem", "map"]
    n "The bag holds [len(bag)] items, from [bag[0]] to [bag[-1]]."
    n "Slice [1:3] gives [bag[1:3]]."
    if "key" in bag and "rope" not in bag:
        n "A small key glints at the bottom — but no rope."
    $ lucky = pick_one(["heads", "tails"])
    n "Flip a coin... [lucky]!"
    $ doubled = double_it(21)
    n "double_it(21) = [doubled]. Neat, right?"

    # input / confirm: text entry and a yes/no prompt bound to vars.
    input player_name "What's your name?"
    confirm sure "Really, [player_name]?"
    if not sure:
        $ player_name = "Stranger"
    e "Nice to meet you, [player_name]!"

    # NVL mode: full-window narrator lines, then a cleared page.
    nv "Later, I would remember this afternoon in fragments."
    nv "The gold light. Her voice. The weight of a name spoken aloud."
    nvl clear
    window hide
    scene bg school with dissolve 1.0
    window show
    n "The afternoon wore on."

    menu set mood:
        "Let's go to the library.":
            $ went_library = True
            jump library
        "Let's watch the sunset from the rooftop.":
            $ went_library = False
            jump sunset
        "Actually, I need to head home.":
            $ went_library = False
            $ went_home = True
            jump home

label library:
    stop music fade 1.5
    scene bg library with blinds 1.0
    play music "bgm_library.ogg" fade 2.0
    n "The library was quiet, the air thick with the smell of old books."
    n "Dust motes floated in the golden light streaming through the windows."
    play sfx "sfx_door.ogg" volume 0.7
    show eileen thinking at left, bob
    e "I love this place. It's so peaceful."
    e "Do you come here often?"
    n "She traced her finger along a row of book spines, lost in thought."

    # Call user-defined function
    call thought

    menu:
        "All the time. It's my favorite spot.":
            show eileen happy at left with dissolve
            e "Really? Maybe we should come here together more often."
            $ eileen_affection = 2
        "Not really. I prefer being outside.":
            show eileen thinking at left with dissolve
            e "I see. Well, maybe I can change your mind."
            $ eileen_affection = 0
        "Only when I need to study for exams.":
            show eileen surprised at left with dissolve
            e "So practical! You're so different from me."
            $ eileen_affection = 1

    n "We found a quiet corner and sat down across from each other."
    show eileen happy at left, fadein
    e "You know, I don't usually invite people here."
    e "This is kind of my secret spot."

    if apology:
        e "I forgive you for being late, by the way."
        e "I know the teacher can be tough sometimes."
    else:
        e "Don't worry about earlier. It doesn't matter."
        e "I'm just happy we're here now."

    n "We spent the afternoon reading in comfortable silence."
    n "The sound of pages turning was the only thing breaking the stillness."
    pause 1.5
    n "Before we knew it, the library was closing."
    play sfx "sfx_door.ogg" volume 0.7
    jump ending

label sunset:
    stop music fade 1.5
    scene bg rooftop with zoom 1.0
    play music "bgm_rooftop.ogg" fade 2.0
    ambient 0.45 0.4 0.55
    light "sun" x=0.78 y=0.18 radius=0.65 intensity=1.1 color="#ff9040"
    light "city" x=0.2 y=0.95 radius=0.5 intensity=0.4 color="#4466ff"
    camera y=0.02 zoom=1.06 over=2.0
    music layer "wind" "sfx_wind.ogg" volume=0.25 fade=2.0
    # Phase 4: named channels — a looping filtered ambience channel and
    # a queued one-shot sequence channel.
    play channel amb "sfx_wind.ogg" volume=0.3 fade=2.0 loop
    filter channel amb lowpass cutoff=600 mix=0.4
    play channel seq "sfx_footstep.ogg" volume=0.7
    queue channel seq "sfx_footstep.ogg" volume=0.6
    queue channel seq "sfx_door.ogg" volume=0.5
    n "We climbed the stairs to the rooftop, the city spreading out beneath us."
    n "The sky was a canvas of {color=#ff8800}orange{/color}, {color=#ff4080}pink{/color}, and {color=#4040ff}deep purple{/color}."
    show eileen happy at center with slideright 0.6
    e "Isn't it beautiful?"
    e "I could stay up here forever."
    n "She leaned against the railing, her hair catching the last light."

    # Demonstrate transform (ATL-style)
    transform eileen scale=1.1
    e "Look at the horizon..."
    transform eileen rotation=0.1
    n "She tilted her head slightly, lost in the view."
    transform eileen rotation=0.0 scale=1.0
    e "It's moments like these that make life worth living."

    menu:
        "It's stunning. Thank you for bringing me.":
            show eileen happy at center
            e "I'm glad you like it."
            e "I wanted to share this with someone special."
            $ eileen_affection = 2
        "The view is nice, but it's kind of windy.":
            show eileen thinking at center
            music layer "wind" volume=0.6 fade=1.0
            volume channel amb 0.65 fade=1.0
            filter channel amb off
            e "You're always so practical."
            e "Can't you just enjoy the moment?"
            $ eileen_affection = 0
        "I prefer the library, honestly.":
            show eileen surprised at center
            e "What? The sunset is right there!"
            e "You're hopeless, you know that?"
            $ eileen_affection = -1

    n "The sky turned from gold to pink to deep purple."
    n "The first stars began to appear, faint but persistent."
    show eileen thinking at center
    e "Hey... can I ask you something?"

    if apology:
        e "Thank you for being here with me."
        e "Even after you were late, you still came."
    else:
        e "You always know how to make me happy."
        e "Even when you're difficult, I enjoy your company."

    n "The moment felt fragile, like it could shatter at any second."
    pause 1.5
    n "But it was perfect."
    jump ending

label home:
    stop music fade 1.5
    scene bg street with pushleft 1.0
    play music "bgm_rooftop.ogg" fade 2.0
    n "I turned to leave, but something made me hesitate."
    show duo at center
    n "Ren had caught up with Eileen — they waved me over together."
    show eileen thinking at center
    hide duo with dissolve 0.5
    e "Oh... you're leaving already?"
    e "I was hoping we could spend some time together."
    play sfx "sfx_phone.ogg" volume 0.8
    n "My phone buzzed in my pocket. I ignored it."

    menu:
        "Actually, maybe I can stay a bit longer.":
            show eileen happy at center
            e "Really? You mean it?"
            e "Great! Let's go to the rooftop. The sunset is amazing."
            $ eileen_affection = 1
            jump sunset
        "I really have to go. Sorry, Eileen.":
            show eileen sad at center
            e "I understand. Family comes first."
            e "Text me when you get home, okay?"
            $ eileen_affection = -1
            n "She waved as I walked away, her smile fading."
            jump ending_sad

label ending:
    stop all fade=2.0
    unlight "sun"
    unlight "city"
    ambient 1.0 1.0 1.0
    camera x=0.0 y=0.0 zoom=1.0
    hide eileen with dissolve 1.0
    scene bg black with fade 2.0
    play music "bgm_ending.ogg" fade 3.0
    pause 1.0

    if eileen_affection >= 2:
        n "That day marked the beginning of something new."
        n "Eileen and I grew closer with each passing week."
        n "The library became our place, the rooftop our secret."
        n "And the sunset we shared that evening..."
        n "...was the first of many."
        n ""
        n "THE END - True Ending"
        grant true_end
        $ persistent.true_end = True
        $ persistent.endings_seen = persistent.get("endings_seen", 0) + 1
        if persistent.endings_seen >= 3:
            grant all_endings
    elif eileen_affection >= 0:
        n "That day was one I wouldn't soon forget."
        n "Eileen and I remained friends, though nothing more."
        n "Sometimes I wonder what would have happened if I'd made different choices."
        n ""
        n "THE END - Normal Ending"
        $ persistent.endings_seen = persistent.get("endings_seen", 0) + 1
        if persistent.endings_seen >= 3:
            grant all_endings
    else:
        n "That day ended quietly."
        n "Eileen and I drifted apart after that."
        n "I sometimes see her in the hallway, but we only nod."
        n "Some moments only come once."
        n ""
        n "THE END - Bad Ending"
        $ persistent.endings_seen = persistent.get("endings_seen", 0) + 1
        if persistent.endings_seen >= 3:
            grant all_endings

    pause 2.0
    end

label ending_sad:
    stop channel amb fade=1.0
    stop channel seq fade=0.5
    stop music fade 2.0
    scene bg black with fade 2.0
    play music "bgm_ending.ogg" fade 3.0
    shake intensity=0.5 duration=0.5
    n "I walked home alone that evening."
    n "The streetlights flickered on one by one as the sun disappeared."
    n "I couldn't help but feel I'd missed something important."
    n "Maybe next time, I told myself."
    n "Maybe next time."
    n ""
    n "THE END - Lonely Ending"
    $ persistent.endings_seen = persistent.get("endings_seen", 0) + 1
    if persistent.endings_seen >= 3:
        grant all_endings
    pause 2.0
    end
